{
  "name": "layerwise-app",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "check-types": "tsc --noEmit",
    "test:feeds": "node --experimental-strip-types --test src/lib/*.test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "release": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "auth:generate": "pnpm dlx auth@latest generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-local.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@layerwise/vite": "^0.1.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
